{
  "name": "@pos/print-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Node service running on a Raspberry Pi in the shop. Pulls print jobs from the API and fires them at an ESC/POS printer over LAN.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pos/shared": "workspace:*",
    "node-thermal-printer": "^4.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

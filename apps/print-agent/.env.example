# Copy to apps/print-agent/.env
#
# Defaults are DRY-RUN: the agent renders slips to stdout and touches no
# hardware. Point it at a real printer only when you have one.

# The POS API. On the Pi this is the LAN address of the machine running it.
API_URL="http://localhost:3001/api"

# Must match PRINT_AGENT_TOKEN in apps/api/.env
PRINT_AGENT_TOKEN="dev-only-print-agent-token-change-me"

# Which printer this agent drives, and a stable name for this process.
STATION="counter"
AGENT_ID="pi-counter-1"

# ---------------------------------------------------------------------------
# Printer connection
#   dry-run : render to stdout, no hardware        <- default
#   tcp     : network printer at PRINTER_HOST:PRINTER_PORT (most common)
#   printer : an OS print queue by name (USB via CUPS on the Pi)
# ---------------------------------------------------------------------------
PRINTER_INTERFACE="dry-run"
PRINTER_HOST="192.168.1.100"
PRINTER_PORT=9100
PRINTER_NAME=""

# ESC/POS dialect. "epson" covers almost every 80mm receipt printer sold in
# Thailand, including the unbranded ones.
PRINTER_TYPE="epson"

# Thai code page. Both encode TIS-620 but select a different font bank:
#   TIS11_THAI -> ESC t 21
#   TIS18_THAI -> ESC t 26
# If tone marks sit in the wrong place, try the other one before concluding
# the printer cannot do Thai.
PRINTER_CHARSET="TIS11_THAI"

# Printable columns: 48 = 80mm Font A, 32 = 58mm.
PRINTER_WIDTH=48

POLL_INTERVAL_MS=1500
PRINTER_TIMEOUT_MS=5000

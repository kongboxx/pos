# Copy to apps/api/.env and adjust. Matches docker-compose.yml defaults.
DATABASE_URL="postgresql://pos:pos_dev_password@localhost:5432/pos_dev?schema=public"

PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Signing key for the PIN -> JWT session cookie (Step 2).
# Generate a real one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="dev-only-secret-change-me-before-anyone-else-uses-this"

# Shared secret the print agent on the Raspberry Pi presents to claim jobs.
# Must match PRINT_AGENT_TOKEN in apps/print-agent/.env
PRINT_AGENT_TOKEN="dev-only-print-agent-token-change-me"

# Origin of the PWA, for CORS + cookie settings.
WEB_ORIGIN="http://localhost:5173"

# ---------------------------------------------------------------------------
# Setting up a REAL shop: `pnpm db:seed` reads these, once.
#
# All optional. Leave them out and you get "ร้านของฉัน" (HQ) with an owner
# called "เจ้าของร้าน" and a randomly generated PIN printed on screen — which
# is fine, because the name is editable in ตั้งค่าสาขา afterwards. The one
# thing that is NOT editable once the first receipt prints is SHOP_CODE: it is
# part of every document number for the year (rule #9).
#
# Nothing here affects `pnpm db:seed:demo` (the noodle shop) or the running
# server — the API never reads them.
# ---------------------------------------------------------------------------
# SHOP_NAME="ผัดไทยเจ๊หน่อย"
# SHOP_CODE="PT1"
# OWNER_NAME="หน่อย ใจดี"
# OWNER_NICKNAME="เจ๊หน่อย"
# OWNER_PIN="8391"
